{
  "name": "opencode",
  "server_info": {
    "name": "opencode-models",
    "version": "0.1.0"
  },
  "protocol_version": "2025-06-18",
  "tools": [
    {
      "name": "opencode_list_models",
      "description": "List retrieved + indexed opencode models (searchable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "free_only": {
            "type": "boolean"
          },
          "refresh": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "opencode_chat",
      "description": "Chat with any opencode model by ref.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Ref like opencode-go/beam-free."
          },
          "messages": {
            "type": "array"
          },
          "prompt": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      }
    },
    {
      "name": "opencode_default_model",
      "description": "Return the serve's default model ref.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "opencode_get_model",
      "description": "Return one model's detail (cost/variants/limits).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      }
    },
